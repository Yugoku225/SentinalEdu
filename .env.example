# Copy to .env and fill in. Never commit .env.
# Only GEMINI_API_KEY is required; every other line shows its default.
GEMINI_API_KEY=your-gemini-api-key-here

# Chosen 2026-11-16 from the Phase 3 comparison (SENTINELEDU_DECISIONS.md D-03)
GEMINI_OCR_MODEL=gemini-3.5-flash
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_S=120

EMBEDDING_MODEL=all-MiniLM-L6-v2
TROCR_MODEL_PATH=my_trocr_model
OFFLINE_MODE=false
EXTRACTION_REVIEW_THRESHOLD=0.6
NEAR_DUP_THRESHOLD=0.92
SIMILAR_THRESHOLD=0.85
INTEGRITY_MARGIN=0.10
INTEGRITY_MIN_TOKENS=15
RAG_TOP_K=4
STORAGE_DIR=storage
